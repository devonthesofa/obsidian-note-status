{
	"name": "obsidian-note-status",
	"version": "3.1.3",
	"packageManager": "pnpm@12.21.0",
	"description": "Enhance your note organization with a status management system. Assign and track statuses (active, on hold, completed, dropped) for your notes with a customizable interface including status pane, dropdown, and file explorer integration.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"check": "pnpm run format:check && pnpm run lint",
		"prepare": "husky install"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"commander": "13.1.0",
		"esbuild": "0.17.3",
		"eslint": "9.39.4",
		"eslint-plugin-obsidianmd": "0.5.1",
		"husky": "^8.0.0",
		"nano-staged": "1.0.2",
		"obsidian": "1.14.4",
		"prettier": "^3.2.5",
		"tslib": "2.4.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.74.0"
	},
	"nano-staged": {
		"*.{ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md}": [
			"prettier --write"
		]
	}
}
